{
  "name": "jotter",
  "version": "1.0.0",
  "private": true,
  "description": "Jotter - Local-First Markdown Kanban Board",
  "scripts": {
    "dev:backend": "python3 run.py",
    "dev:frontend": "cd frontend && npm run dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dev": "concurrently --kill-others-on-fail --names \"Backend,Frontend\" --prefix-colors \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:frontend",
    "test:backend": "python3 -m pytest tests/backend/",
    "test:frontend": "cd frontend && npm run test",
    "test": "npm run test:backend && npm run test:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:frontend:fix": "cd frontend && npm run lint:fix",
    "lint": "npm run lint:frontend",
    "lint:fix": "npm run lint:frontend:fix",
    "format:frontend": "cd frontend && npm run format",
    "format:frontend:check": "cd frontend && npm run format:check",
    "format": "npm run format:frontend",
    "format:check": "npm run format:frontend:check",
    "install:all": "npm install && cd frontend && npm install && cd .. && pip install -e .[dev]"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "^6.4.2",
    "esbuild": "^0.28.1"
  }
}
