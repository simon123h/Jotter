{
  "description": "Completing a task with a `repeat` rule rolls it over (spec/FORMAT.md, Recurring tasks). `task` holds the fields the roll reads, `previous_bucket` is the bucket before completion (null when unknown), `expected` is the result. The default bucket of the project is `backlog`.",
  "default_bucket": "backlog",
  "cases": [
    {
      "name": "completion-weekly-no-dates",
      "description": "Without dates the task is planned for the next occurrence, and goes back to its bucket.",
      "today": "2026-10-12",
      "task": {
        "repeat": {
          "every": 1,
          "unit": "week",
          "from": "completion"
        },
        "previous_bucket": "todo"
      },
      "expected": {
        "bucket": "todo",
        "due_date": null,
        "planned_date": "2026-10-19",
        "reminders": [],
        "body": ""
      }
    },
    {
      "name": "due-on-time",
      "description": "Completed on its due day: one step ahead. A planned day and the reminders move with it.",
      "today": "2026-10-12",
      "task": {
        "repeat": {
          "every": 1,
          "unit": "week",
          "from": "due"
        },
        "due_date": "2026-10-12",
        "planned_date": "2026-10-12",
        "reminders": [
          "2026-10-11T18:00"
        ],
        "previous_bucket": "in-progress"
      },
      "expected": {
        "bucket": "in-progress",
        "due_date": "2026-10-19",
        "planned_date": "2026-10-19",
        "reminders": [
          "2026-10-18T18:00"
        ],
        "body": ""
      }
    },
    {
      "name": "due-early",
