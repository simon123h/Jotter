{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@jotter/checklist": ["../../packages/checklist/index.ts"],
      "@jotter/vault-format/types": ["../../packages/vault-format/src/types.ts"],
      "@jotter/links": ["../../packages/links/index.ts"],
      "@jotter/themes": ["../../packages/themes/index.ts"],
      "@jotter/title-parser": ["../../packages/title-parser/index.ts"],
      "@jotter/task-filter": ["../../packages/task-filter/index.ts"],
      "pinia": ["./node_modules/pinia/dist/pinia.d.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
