    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.12.3",
    "@types/sortablejs": "^1.15.9",
